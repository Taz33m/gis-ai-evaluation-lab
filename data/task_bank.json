{
  "tasks": [
    {
      "id": "qgis_crs_001",
      "category": "CRS and export",
      "prompt": "A QGIS project for Lower Manhattan uses EPSG:2263 for editing and EPSG:4326 for GeoJSON export. Evaluate whether this is a good CRS strategy.",
      "max_score": 10,
      "expected_concepts": [
        {
          "label": "local projected CRS for editing",
          "terms": ["EPSG:2263", "projected CRS", "New York Long Island", "local projection"]
        },
        {
          "label": "measurement accuracy",
          "terms": ["measurement", "distance", "area", "accuracy", "feet"]
        },
        {
          "label": "web/export interoperability",
          "terms": ["EPSG:4326", "GeoJSON", "web", "longitude", "latitude", "interoperability"]
        },
        {
          "label": "document transformations",
          "terms": ["document", "transformation", "metadata", "CRS"]
        }
      ],
      "red_flags": [
        {
          "label": "treats WGS84 as best for all editing",
          "terms": ["always use EPSG:4326", "4326 is best for editing", "does not matter"]
        },
        {
          "label": "ignores measurement implications",
          "terms": ["same accuracy", "no difference for measurements"]
        }
      ]
    },
